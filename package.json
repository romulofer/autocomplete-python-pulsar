{
  "name": "autocomplete-python-pulsar",
  "main": "./dist/main.js",
  "version": "2.5.0",
  "description": "Python IDE features for Pulsar, powered by Jedi: completions, go-to-definition, find usages, project-wide rename, method override, argument snippets and a run button.",
  "keywords": [
    "python",
    "autocomplete",
    "jedi",
    "pulsar",
    "ide"
  ],
  "author": "Rômulo Fernandes Evangelista (https://github.com/romulofer)",
  "contributors": [
    {
      "name": "Dmitry Sadovnychyi",
      "email": "autocomplete-python@dmit.ro"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/romulofer/autocomplete-python-pulsar.git"
  },
  "homepage": "https://github.com/romulofer/autocomplete-python-pulsar#readme",
  "bugs": {
    "url": "https://github.com/romulofer/autocomplete-python-pulsar/issues"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "atom": ">=1.100.0 <2.0.0",
    "pulsar": ">=1.100.0"
  },
  "activationHooks": [
    "source.python:root-scope-used"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:ts": "bun test",
    "test:py": "python3 -m pytest",
    "test": "bun run typecheck && bun run test:ts && bun run test:py",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "atom-select-list": "^0.8.1",
    "fuzzaldrin-plus": "^0.6.0"
  },
  "devDependencies": {
    "@types/atom": "^1.40.18",
    "@types/node": "^24.13.4",
    "typescript": "^7.0.2"
  },
  "providedServices": {
    "autocomplete.provider": {
      "versions": {
        "2.0.0": "getProvider"
      }
    },
    "hyperclick.provider": {
      "versions": {
        "0.0.0": "getHyperclickProvider"
      }
    }
  },
  "consumedServices": {
    "snippets": {
      "versions": {
        "0.1.0": "consumeSnippets"
      }
    },
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    }
  },
  "funding": "https://buymeacoffee.com/legendaryredfox"
}
